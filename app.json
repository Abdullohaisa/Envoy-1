{
  "expo": {
    "name": "Envoy-1",
    "slug": "Envoy-1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.abdulloh_asia.Envoy1"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/Inter_18pt-Regular.ttf",
            "./src/assets/fonts/Inter_18pt-Medium.ttf",
            "./src/assets/fonts/Inter_18pt-SemiBold.ttf",
            "./src/assets/fonts/Inter_18pt-Bold.ttf",
            "./src/assets/fonts/Inter_18pt-Italic.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sizning suratlaringizni tanlash uchun ruxsat bering.",
          "cameraPermission": "Suratga olish uchun ruxsat bering."
        }
      ],
      "expo-audio"
    ],
    "scheme": "envoy-1",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a667aa8-3f50-4533-9acc-4d7e70150bd3"
      }
    }
  }
}
