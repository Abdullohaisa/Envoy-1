{
  // Faylni saqlaganingizda VS Code avtomatik kodni formatlaydi (ya'ni tartibga soladi, masalan, bo‘sh joylar, verguldan keyingi bo‘shliq va hokazo).
  "editor.formatOnSave": true,

  // Faylni saqlaganda ESLint'ning barcha mavjud tuzatishlarini avtomatik bajarsin degan buyruq.
